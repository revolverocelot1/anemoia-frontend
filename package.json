  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node -e \"const fs = require('fs'); const path = require('path'); const src = path.resolve(__dirname, 'node_modules/onnxruntime-web/dist'); const dst = path.resolve(__dirname, 'public/ort-wasm'); if (!fs.existsSync(dst)) fs.mkdirSync(dst, { recursive: true }); fs.readdirSync(src).forEach(file => { if (file.endsWith('.wasm')) { fs.copyFileSync(path.join(src, file), path.join(dst, file)); } });\""
  },
