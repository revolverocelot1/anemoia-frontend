{
  "name": "advanced-image-comparison",
  "version": "2.0.0",
  "description": "High-performance image comparison library with UI analysis",
  "main": "src/comparison.js",
  "type": "module",
  "scripts": {
    "test": "node test/performance-test.js",
    "benchmark": "node test/benchmark.js",
    "optimize": "node scripts/optimize.js"
  },
  "keywords": [
    "image-comparison",
    "ui-analysis",
    "webgl",
    "performance",
    "srp-optimized"
  ],
  "author": {
    "name": "Advanced Graphics Lab",
    "email": "contact@advancedgraphics.lab"
  },
  "contributors": [
    {
      "name": "S.R.P",
      "email": "srp@optimization.lab"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "canvas": "^2.11.2",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64"
