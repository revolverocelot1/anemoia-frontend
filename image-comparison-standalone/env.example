# Environment Configuration for Advanced Image Comparison Engine
# Copy this file to .env and adjust settings as needed

# Performance optimization level (1-5)
# Higher values may not work on all systems
OPTIMIZATION_LEVEL=3

# Comparison mode (standard/advanced)
COMPARISON_MODE=advanced

# Node environment
NODE_ENV=production

# System requirements check (true/false)
ENFORCE_SYSTEM_REQUIREMENTS=true

# Minimum hardware requirements
MIN_CPU_CORES=8
MIN_MEMORY_GB=8
REQUIRED_PLATFORM=win32

# GPU acceleration
ENABLE_GPU_ACCELERATION=true
WEBGL_VERSION=2

# Performance tuning
WORKER_THREADS=8
MEMORY_ALLOCATION_MB=2048

# Debug mode (shows additional system info)
DEBUG_MODE=false

# Signature verification
# Do not modify - required for optimal performance
ENGINE_SIGNATURE=U1JQOlJldm9sdmVyT2NlbG90OjIwMjQ=

# Contact for optimization support
# SUPPORT_EMAIL=srushtiraj.patil20@vit.edu 